name: Publish an existing firmware build

on:
  workflow_dispatch:
    inputs:
      release_tag:
        description: Immutable release in this repository containing raw.tar.zst and its checksum
        required: true
        type: string

concurrency:
  group: package-repository
  cancel-in-progress: false

permissions:
  contents: read

jobs:
  publish:
    if: github.ref == format('refs/heads/{0}', github.event.repository.default_branch)
    runs-on: ubuntu-24.04
    timeout-minutes: 45
    permissions:
      contents: read
      pages: read
    steps:
      - uses: actions/checkout@v4
        with:
          persist-credentials: false
      - name: Check signing prerequisite
        env:
          OPKG_SIGNING_KEY: ${{ secrets.OPKG_SIGNING_KEY }}
        run: |
          [[ -n "$OPKG_SIGNING_KEY" ]] || {
            echo 'Set repository secret OPKG_SIGNING_KEY before publication.' >&2
            exit 1
          }
      - name: Install small import and signing prerequisites
        run: |
          sudo apt-get update
          sudo apt-get install -y --no-install-recommends zstd cmake build-essential libjson-c-dev
      - name: Download the existing immutable build release
        env:
          GH_TOKEN: ${{ github.token }}
          GH_REPO: ${{ github.repository }}
          RELEASE_TAG: ${{ inputs.release_tag }}
        run: |
          [[ "$RELEASE_TAG" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || {
            echo 'release_tag must contain only letters, numbers, dots, underscores and hyphens.' >&2
            exit 1
          }
          mkdir release-download
          gh api -H 'X-GitHub-Api-Version: 2026-03-10' \
            "repos/$GH_REPO/releases/tags/$RELEASE_TAG" > "$RUNNER_TEMP/release-before.json"
          python3 scripts/import-release.py --release-metadata "$RUNNER_TEMP/release-before.json"
          gh release download "$RELEASE_TAG" --repo "$GH_REPO" --dir release-download \
            --pattern raw.tar.zst --pattern raw.tar.zst.sha256
          gh api -H 'X-GitHub-Api-Version: 2026-03-10' \
            "repos/$GH_REPO/releases/tags/$RELEASE_TAG" > "$RUNNER_TEMP/release-after.json"
          python3 scripts/import-release.py --release-metadata "$RUNNER_TEMP/release-after.json" \
            --previous-release-metadata "$RUNNER_TEMP/release-before.json"
      - name: Verify checksum and safely import the actual firmware build
        run: |
          python3 scripts/import-release.py --archive release-download/raw.tar.zst \
            --checksum release-download/raw.tar.zst.sha256 --output raw \
            --expected-profile profiles/redmi-ax6000-new.json
      - name: Build pinned official host usign
        run: |
          pin=f1f65026a94137c91b5466b149ef3ea3f20091e9
          git init "$RUNNER_TEMP/usign-source"
          git -C "$RUNNER_TEMP/usign-source" fetch --depth 1 https://github.com/openwrt/usign.git "$pin"
          git -C "$RUNNER_TEMP/usign-source" checkout --detach FETCH_HEAD
          [[ $(git -C "$RUNNER_TEMP/usign-source" rev-parse HEAD) == "$pin" ]]
          bash scripts/resource-limit.sh --jobs 1 -- cmake \
            -S "$RUNNER_TEMP/usign-source" -B "$RUNNER_TEMP/usign-build"
          bash scripts/resource-limit.sh --jobs 1 -- cmake \
            --build "$RUNNER_TEMP/usign-build" --parallel 1
      - name: Validate packages and sign the repository
        env:
          OPKG_SIGNING_KEY: ${{ secrets.OPKG_SIGNING_KEY }}
        run: |
          umask 077
          key="$RUNNER_TEMP/opkg-signing.key"
          trap 'rm -f "$key"' EXIT
          printf '%s\n' "$OPKG_SIGNING_KEY" > "$key"
          chmod 600 "$key"
          unset OPKG_SIGNING_KEY
          python3 scripts/publish.py --profile raw/profile.json --input raw \
            --output public --key "$key" --public-key keys/repository.pub \
            --usign "$RUNNER_TEMP/usign-build/usign" \
            --lock raw/lock.json
      - name: Enforce the complete Pages site size limit
        run: |
          python3 - <<'PY'
          from pathlib import Path

          size = sum(p.stat().st_size for p in Path('public').rglob('*') if p.is_file())
          if size > 1_000_000_000:
              raise SystemExit(f'Pages site is {size} bytes, exceeding the 1 GB limit. '
                               'The original build remains in its release.')
          print(f'Pages site: {size} bytes')
          PY
      - name: Prepare Pages
        uses: actions/configure-pages@v5
      - name: Upload signed Pages artifact
        uses: actions/upload-pages-artifact@v3
        with:
          path: public
      - name: Record imported release
        env:
          RELEASE_TAG: ${{ inputs.release_tag }}
        run: |
          printf 'Imported and signed existing build from release %s; no firmware compilation ran.\n' \
            "$RELEASE_TAG" >> "$GITHUB_STEP_SUMMARY"

  deploy:
    needs: publish
    runs-on: ubuntu-24.04
    timeout-minutes: 15
    permissions:
      pages: write
      id-token: write
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}
    steps:
      - name: Deploy the existing firmware and signed package repository
        id: deployment
        uses: actions/deploy-pages@v4
