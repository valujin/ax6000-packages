SPRD: use the exported Linux 6.6 scheduler API for kernel worker threads.

sched_setscheduler is not exported to modules. sched_setattr_nocheck accepts
these kernel threads while preserving their requested SCHED_RR policy and
90 real-time priority. Initialize sched_attr.size explicitly; existing
uapi/linux/sched/types.h includes provide its definition on Linux 6.6.

Reference:
https://github.com/torvalds/linux/blob/v6.6/kernel/sched/core.c

--- a/package/mtk/applications/5g-modem/quectel_SRPD_PCIE/src/sipa/sipa_skb_send.c
+++ b/package/mtk/applications/5g-modem/quectel_SRPD_PCIE/src/sipa/sipa_skb_send.c
@@ -284,12 +284,16 @@
 static int sipa_free_thread(void *data)
 {
 	struct sipa_skb_sender *sender = (struct sipa_skb_sender *)data;
-	struct sched_param param = {.sched_priority = 90};
+	struct sched_attr param = {
+		.size = sizeof(struct sched_attr),
+		.sched_policy = SCHED_RR,
+		.sched_priority = 90,
+	};
 	struct sipa_core *ctrl = sipa_get_ctrl_pointer();
 	enum sipa_cmn_fifo_index id = sender->ep->send_fifo->fifo_id;
     unsigned long flags;
 	struct sipa_nic *iter, *_iter;
-	sched_setscheduler(current, SCHED_RR, &param);
+	sched_setattr_nocheck(current, &param);
 
 	while (!kthread_should_stop()) {
 		wait_event_interruptible(sender->free_waitq,
